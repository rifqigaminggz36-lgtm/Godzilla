            TARGET_CFRAMES[id] = nil
            LAST_SEND_TIME[id] = nil
            COLOR_SENDING[id] = nil
            NETWORK_STATE[id] = nil
        end
    end

    local children = targetFolder:GetChildren()
    table.sort(children, function(a, b) return a:GetDebugId() < b:GetDebugId() end)

