Connections[2] = RS.Heartbeat:Connect(function(dt)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")

    if IsInvisible and root and hum then
        local OriginalCFrame = root.CFrame
        local OriginalCameraOffset = hum.CameraOffset
        local DownCFrame = OriginalCFrame * CFrame.new(0, -500000, 0)
        root.CFrame = DownCFrame
        hum.CameraOffset = DownCFrame:ToObjectSpace(CFrame.new(OriginalCFrame.Position)).Position
        RS.RenderStepped:Wait()
        root.CFrame = OriginalCFrame
        hum.CameraOffset = OriginalCameraOffset
    end

    if petMode then
        local t = tick()
        if t % 0.5 < dt then UpdateAndValidateRodanProps() end

        local totalRegisteredProps = TOTAL_MAX_PROPS

        if root then
            local VirtualRootCFrame = root.CFrame
            local currentPos = VirtualRootCFrame.Position
            local calculatedVelocity = (currentPos - lastPosition) / math.max(dt, 0.001)
            lastPosition = currentPos

            local moveSpeed = calculatedVelocity.Magnitude
            local isWalking = moveSpeed > 1

            -- [[ CHECK & HANDLE TIMER DURASI ATOMIC BEAM ]] --
            if IsAtomicActive then
                if t - AtomicTimer >= AtomicBreathDuration then
                    IsAtomicActive = false
                    snapNextFrame = true
                    AtomicBtn.Text = "SKILL: ATOMIC BEAM"
                    AtomicBtn.BackgroundColor3 = Color3.fromRGB(45, 10, 60)
                    AtomicBtn.TextColor3 = Color3.new(0.85, 0.95, 1)
                else
                    local timeLeft = math.max(0, math.ceil(AtomicBreathDuration - (t - AtomicTimer)))
                    AtomicBtn.Text = "ATOMIC BREATH = " .. timeLeft
                end
            end

            -- [[ DETERMINASI ACTIVE CONFIG MATRIX ]] --
            local activeConfig = Config.Idle
            local lerpSpeed = 5.0

            if IsAtomicActive then
                activeConfig = Config.Atomic
                lerpSpeed = 3.5
            elseif isWalking then
                activeConfig = Config.Walk
                lerpSpeed = 4.2
            end

            local localLerpAlpha = math.clamp(1 - math.exp(-lerpSpeed * dt), 0, 1)

            local walkAnimSpeed = 2.4
            local rawSin = math.sin(t * walkAnimSpeed)
            local walkWeight = math.clamp((rawSin * 1.4) + 0.5, 0, 1)

            if estimatedPing > 0.15 then
                NETWORK_TICK_RATE = math.clamp(estimatedPing * 0.5, BASE_TICK_RATE, 0.08)
            else
                NETWORK_TICK_RATE = BASE_TICK_RATE
            end

            local safePing = math.clamp(estimatedPing, 0.01, 0.2)
            local predictedPosition = currentPos + (calculatedVelocity * safePing)

            local baseTargetCF = CFrame.new(predictedPosition, predictedPosition + VirtualRootCFrame.LookVector)
            local finalPos = baseTargetCF * CFrame.new(activeConfig.Offset.X, activeConfig.Offset.Y, activeConfig.Offset.Z)
            local rotCF = CFrame.Angles(math.rad(activeConfig.Rotation.X), math.rad(activeConfig.Rotation.Y), math.rad(activeConfig.Rotation.Z))

            if snapNextFrame then localLerpAlpha = 1 end

            -- [[ SCAN JALUR BEAM DEBOUNCED BANISHER ENGINE ]] --
            local scannedTarget = nil
            if IsAtomicActive and (math.floor(t * 10) % 2 == 0) then -- DI-DEBOUNCE AGAR TIDAK SPAM OVERHEAD
                for _, player in pairs(Players:GetPlayers()) do
                    if player ~= LP and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        local enemyRoot = player.Character.HumanoidRootPart
                        for scanId = 11, 13 do
                            local scannerProp = PROP_CACHE[scanId]
                            if scannerProp and scannerProp.Parent then
                                if (enemyRoot.Position - scannerProp.Position).Magnitude < 35 then
                                    scannedTarget = player
                                    break
                                end
                            end
                        end
                    end
                    if scannedTarget then break end
                end
            end

            -- CALCULATION INDEX ALL PROPS
            for id = 1, totalRegisteredProps do
                local prop = PROP_CACHE[id]
                if prop and prop.Parent then
                    local mixedOffset

                    if IsAtomicActive then
                        mixedOffset = AnimationPool.Atomic[id] or AnimationPool.Atomic[((id - 1) % #AnimationPool.Atomic) + 1]
                    elseif isWalking then
                        local offset1 = AnimationPool.Walk1[id] or AnimationPool.Walk1[((id - 1) % #AnimationPool.Walk1) + 1]
                        local offset2 = AnimationPool.Walk2[id] or AnimationPool.Walk2[((id - 1) % #AnimationPool.Walk2) + 1]
                        mixedOffset = offset1:Lerp(offset2, walkWeight)
                    else
                        mixedOffset = AnimationPool.Idle[id] or AnimationPool.Idle[((id - 1) % #AnimationPool.Idle) + 1]
                    end

                    -- FIXED TRANSITION MATRIX OFFSET COMPENSATOR
                    local targetCF = finalPos * rotCF * mixedOffset
                    TARGET_CFRAMES[id] = targetCF

                    -- [[ LOGIKA GERAKAN RANDOM ATOMIC BREATH BANISHER (PROP 57-60) ]] --
                    if IsAtomicActive and (id >= 57 and id <= 60) and scannedTarget and scannedTarget.Character then
                        local enemyRoot = scannedTarget.Character:FindFirstChild("HumanoidRootPart") or scannedTarget.Character:FindFirstChild("Torso")
                        local enemyHum = scannedTarget.Character:FindFirstChildOfClass("Humanoid")

                        if enemyRoot and enemyHum then
                            local targetSeated = false
                            pcall(function()
                                if enemyHum.SeatPart == prop or (enemyRoot.Position - prop.Position).Magnitude < 8 then
                                    targetSeated = true
                                end
                            end)

                            if targetSeated then
                                enemyRoot.CFrame = CFrame.new(0, -9e9, 0)
                                CURRENT_CFRAMES[id] = CFrame.new(0, -9e9, 0)
                            else
                                local randomOffset = Vector3.new(
                                    math.random(-12, 12),
                                    math.random(-12, 12),
                                    math.random(-12, 12)
                                )
                                local randomRotation = CFrame.Angles(
                                    math.rad(math.random(0, 360)),
                                    math.rad(math.random(0, 360)),
                                    math.rad(math.random(0, 360))
                                )
                                CURRENT_CFRAMES[id] = CFrame.new(enemyRoot.Position + randomOffset) * randomRotation
                            end
                        end
                    else
                        -- [[ MISSILE SEAT CONTROLLER ENGINE ]] --
                        local managedMissile = nil
                        for _, m in ipairs(MissileData) do if m.Id == id then managedMissile = m break end end

                        if managedMissile and managedMissile.State ~= "Idle" then
                            local elapsed = t - managedMissile.StartTime
                            local targetPlr = managedMissile.TargetPlayer

                            if managedMissile.State == "Void" then
                                CURRENT_CFRAMES[id] = CFrame.new(0, -9e9, 0)
                                if targetPlr and targetPlr.Character then
                                    local enemyRoot = targetPlr.Character:FindFirstChild("HumanoidRootPart") or targetPlr.Character:FindFirstChild("Torso")
                                    if enemyRoot then enemyRoot.CFrame = CFrame.new(0, -9e9, 0) end
                                end

                                if elapsed > 6.0 or not MissileData.TargetAllActive then
                                    managedMissile.State = "Idle"
                                    managedMissile.TargetPlayer = nil
                                    if not MissileData.TargetAllActive then
                                        statusLabel.Text = "Missile Engine Status: READY"
                                        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
                                    end
                                end
                            elseif targetPlr and targetPlr.Parent and Players:FindFirstChild(targetPlr.Name) and targetPlr.Character then
                                local enemyRoot = targetPlr.Character:FindFirstChild("HumanoidRootPart") or targetPlr.Character:FindFirstChild("Torso")
                                local enemyHum = targetPlr.Character:FindFirstChildOfClass("Humanoid")

                                if enemyRoot and enemyHum and enemyHum.Health > 0 then
                                    local isTrapped = false
                                    pcall(function()
                                        if enemyHum.SeatPart == prop or (enemyRoot.Position - prop.Position).Magnitude < 15 then
                                            isTrapped = true
                                        end
                                    end)

                                    if isTrapped then
                                        managedMissile.State = "Void"
                                        managedMissile.StartTime = t
                                        enemyRoot.CFrame = CFrame.new(0, -9e9, 0)
                                        CURRENT_CFRAMES[id] = CFrame.new(0, -9e9, 0)
                                    elseif managedMissile.State == "Launch" then
                                        local alpha = math.clamp(elapsed / managedMissile.LaunchDuration, 0, 1)
                                        local launchHeight = managedMissile.StartCF.Position + Vector3.new(0, 120, 0) + managedMissile.BaseOffset
                                        local currentLaunchPos = managedMissile.StartCF.Position:Lerp(launchHeight, alpha)
                                        CURRENT_CFRAMES[id] = CFrame.new(currentLaunchPos, currentLaunchPos + Vector3.new(0,-5,0))

                                        if alpha >= 1 then managedMissile.State = "Cruise" managedMissile.StartTime = t end
                                    elseif managedMissile.State == "Cruise" then
                                        local startCruisePos = CURRENT_CFRAMES[id] and CURRENT_CFRAMES[id].Position or managedMissile.StartCF.Position
                                        local finalCruisePos = enemyRoot.Position
                                        local currentCruisePos = startCruisePos:Lerp(finalCruisePos, 0.12)
                                        CURRENT_CFRAMES[id] = CFrame.new(currentCruisePos, finalCruisePos)
                                    end
                                else
                                    managedMissile.State = "Idle"
                                    managedMissile.TargetPlayer = nil
                                end
                            else
                                managedMissile.State = "Idle"
                                managedMissile.TargetPlayer = nil
                            end
                        else
                            if managedMissile then
                                local mirrorCF = CURRENT_CFRAMES[managedMissile.MirrorId]
                                CURRENT_CFRAMES[id] = mirrorCF or targetCF
                            else
                                if snapNextFrame or not CURRENT_CFRAMES[id] then
                                    CURRENT_CFRAMES[id] = targetCF
                                else
                                    -- SMOOTH TRANSITION LERP ALPHA FOR BOTH STATES
                                    local currentAlpha = (IsAtomicActive and localLerpAlpha * 0.8) or localLerpAlpha
                                    CURRENT_CFRAMES[id] = CURRENT_CFRAMES[id]:Lerp(targetCF, currentAlpha)
                                end
                            end
                        end
                    end
                end
            end
            if snapNextFrame then snapNextFrame = false end

            local canUpdateColor = (t - lastColorUpdate > 0.04)

            for id = 1, totalRegisteredProps do
                local prop = PROP_CACHE[id]
                if prop and CURRENT_CFRAMES[id] then
                    if t - (LAST_SEND_TIME[id] or 0) >= NETWORK_TICK_RATE and not NETWORK_STATE[id] then
                        local cfR = prop:FindFirstChild("SetCurrentCFrame")
                        if cfR and cfR:IsA("RemoteFunction") then
                            LAST_SEND_TIME[id] = t
                            NETWORK_STATE[id] = true

                            task.spawn(function()
                                local startSend = os.clock()
                                local completed = false

                                task.spawn(function()
                                    local success = pcall(function()
                                        cfR:InvokeServer(CURRENT_CFRAMES[id])
                                    end)
                                    completed = true
                                    NETWORK_STATE[id] = false

                                    if success and id == 1 then
                                        estimatedPing = (estimatedPing * 0.95) + ((os.clock() - startSend) * 0.05)
                                    end
                                end)

                                task.delay(MAX_CHOKE_TIMEOUT, function()
                                    if not completed then NETWORK_STATE[id] = false end
                                end)
                            end)
                        end
                    end

                    if canUpdateColor and id == colorIndex and not COLOR_SENDING[id] then
                        local crR = prop:FindFirstChild("ChangePropColor")
                        if crR then
                            COLOR_SENDING[id] = true
                            task.spawn(function()
                                local finishedColor = false
                                task.spawn(function()
                                    pcall(function()
                                        crR:InvokeServer(getSharkColor(t, id))
                                    end)
                                    finishedColor = true
                                    COLOR_SENDING[id] = false
                                end)
                                task.delay(0.1, function() if not finishedColor then COLOR_SENDING[id] = false end end)
                            end)
                        end
                    end
                end
            end

            if canUpdateColor then
                colorIndex = (colorIndex % totalRegisteredProps) + 1
                lastColorUpdate = t
            end
        end
    end

    if AirWalkActive and root then
        UpdateGroundY()
        local actualTarget = CurrentGroundY + TargetHeight
        SmoothHeight = SmoothHeight + (actualTarget - SmoothHeight) * 0.15

        Platform.Position = Vector3.new(root.Position.X, SmoothHeight - 3.5, root.Position.Z)

        if math.abs(root.Position.Y - SmoothHeight) > 1 then
            root.CFrame = CFrame.new(root.Position.X, SmoothHeight, root.Position.Z)
        end
    end
end)

